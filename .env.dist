# Copy this file to .env on first setup
# .env is git-ignored and contains your local configuration

# Docker Compose Services
DATABASE_URL=mysql://root:secret@db:3306/companion?serverVersion=8.4&charset=utf8mb4
CACHE_URL=redis://cache:6379
MYSQL_ROOT_PASSWORD=secret
MYSQL_PASSWORD=secret

# Application
APP_ENV=dev
APP_SECRET=CHANGE_ME_IN_PRODUCTION
APP_VERSION=0.1.0

# Frontend
VITE_API_URL=http://localhost:8080

# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost:8080

# Local Ollama endpoint (use host.docker.internal on macOS/Windows Docker)
AI_PROVIDER_ENDPOINT=http://host.docker.internal:11434
AI_MODEL=gemma4:latest
